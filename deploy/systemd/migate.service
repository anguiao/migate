[Unit]
Description=MiGate Matter Bridge
Wants=avahi-daemon.service
After=avahi-daemon.service
PartOf=avahi-daemon.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=your-user
ExecStart="/usr/local/bin/migate" --data-dir "/home/your-user/.migate"
Restart=on-failure
RestartSec=10s
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
